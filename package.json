{
  "name": "werift-mediasoup-interop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "type": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "test": "npm run test:small && npm run test:interop",
    "test:small": "TSX_TSCONFIG_PATH=tsconfig.json tsx --test --test-concurrency=1 --test-isolation=process test/small/**/*.test.ts",
    "test:source-import": "TSX_TSCONFIG_PATH=tsconfig.json tsx --test --test-isolation=process test/small/source-import.test.ts",
    "test:interop": "TSX_TSCONFIG_PATH=tsconfig.json tsx --test --test-concurrency=1 --test-isolation=process test/interop/**/*.test.ts",
    "test:browser": "node scripts/bundle-browser-client.mjs && TSX_TSCONFIG_PATH=tsconfig.json tsx --test --test-concurrency=1 --test-isolation=process test/browser/**/*.test.ts",
    "install:browsers": "node scripts/ensure-browser.js",
    "bundle:browser": "node scripts/bundle-browser-client.mjs"
  },
  "dependencies": {
    "mediasoup": "3.26.0",
    "mediasoup-client": "3.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "playwright": "1.55.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "mediasoup@3.26.0": true
  }
}
